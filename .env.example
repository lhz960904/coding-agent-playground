# DeepSeek API key（part 1-4 走 DeepSeek，part 5 也用它做 OpenAI-compatible provider 演示）
DEEPSEEK_API_KEY=

# Anthropic API key（part 5 演示双 provider 时切到 Claude）
ANTHROPIC_API_KEY=

# Anthropic base URL（可选）—— 走自建网关 / AstroPick 等代理时填这里，留空走官方
ANTHROPIC_BASE_URL=

# 单 IP 每天最多触发多少次 run（防刷，默认 100）
RUN_RATE_LIMIT_PER_DAY=100
